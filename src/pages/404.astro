---
import AppShell from '@/layouts/AppShell.astro';
---

<AppShell title="Not found" hasChips={false}>
  <section class="glass mx-auto mt-16 max-w-md space-y-3 p-8 text-center">
    <h1 class="text-2xl font-semibold">Course not found</h1>
    <p class="text-white/60">This page doesn't exist or the course was removed.</p>
    <a href="/" class="chip">Back to all courses</a>
  </section>
</AppShell>
